{
  "manifest_version": 3,
  "name": "textheat — Read the feeling",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Reveal emotional language locally. Off, progressive Auto, or Manual page and click-to-check tools.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup/popup.html", "default_title": "textheat", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "options_page": "options/options.html",
  "commands": {
    "toggle-page": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Toggle whole-page highlighting (Manual mode)" },
    "pick-text": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Click to check specific text (Manual mode)" },
    "check-selection": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Check selected text (Manual mode)" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}