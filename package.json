{
  "name": "textheat",
  "version": "0.1.0",
  "description": "Self-contained contextual sentiment highlighting with safe HTML output",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./styles.css": "./styles/textheat.css",
    "./styles/dark.css": "./styles/textheat-dark.css",
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "textheat": "./dist/cli.js"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "docs",
    "examples",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:package": "node --test scripts/verify-package.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "vite --host 127.0.0.1",
    "site:prepare": "node scripts/prepare-site.mjs",
    "demo:build": "npm run build:extension && npm run site:prepare && vite build",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "test:extension": "npm run build && vitest run tests/extension",
    "verify:extension": "node --test scripts/verify-extension.mjs",
    "prepack": "npm run typecheck && npm run test && npm run test:package"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.5",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
